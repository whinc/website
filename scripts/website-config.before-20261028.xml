<?xml version="1.0" encoding="UTF-8"?>
<!-- 回滚用：2026-10-28 修改前的桶静态网站配置（含导致 404 死循环的遗留 RoutingRules） -->
<WebsiteConfiguration>
	<IndexDocument>
		<Suffix>index.html</Suffix>
	</IndexDocument>
	<ErrorDocument>
		<Key/>
	</ErrorDocument>
	<AutoAddressing>
		<Status>Enabled</Status>
	</AutoAddressing>
	<RoutingRules>
		<RoutingRule>
			<Condition>
				<HttpErrorCodeReturnedEquals>404</HttpErrorCodeReturnedEquals>
			</Condition>
			<Redirect>
				<ReplaceKeyPrefixWith>ucalc-website/</ReplaceKeyPrefixWith>
				<URLRedirect>Enabled</URLRedirect>
			</Redirect>
		</RoutingRule>
	</RoutingRules>
</WebsiteConfiguration>
